ALGORITHM SumOfDistinctElements
VAR
    set1 : ARRAY_OF INTEGER[4] := [3, 1, 7, 9];
    set2 : ARRAY_OF INTEGER[5] := [2, 4, 1, 9, 3];
    sum, i, j : INTEGER;
    found : BOOLEAN;
BEGIN
    sum := 0;

    // Check set1 elements against set2
    FOR i FROM 0 TO 3 DO
        found := FALSE;
        FOR j FROM 0 TO 4 DO
            IF (set1[i] = set2[j]) THEN
                found := TRUE;
            END_IF
        END_FOR
        IF (found = FALSE) THEN
            sum := sum + set1[i];
        END_IF
    END_FOR

    // Check set2 elements against set1
    FOR i FROM 0 TO 4 DO
        found := FALSE;
        FOR j FROM 0 TO 3 DO
            IF (set2[i] = set1[j]) THEN
                found := TRUE;
            END_IF
        END_FOR
        IF (found = FALSE) THEN
            sum := sum + set2[i];
        END_IF
    END_FOR

    Write("Sum of distinct elements: ", sum);
END
