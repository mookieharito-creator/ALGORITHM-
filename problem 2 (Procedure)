FUNCTION dot_product_func(v1, v2 : ARRAY_OF FLOAT) : FLOAT
VAR
    i : INTEGER;
    ps : FLOAT;
BEGIN
    ps := 0;
    FOR i FROM 0 TO v1.length - 1 DO
        ps := ps + (v1[i] * v2[i]);
    END_FOR
    RETURN ps;
END_FUNCTION


ALGORITHM CheckOrthogonalityFunction
VAR
    v1, v2 : ARRAY_OF FLOAT[3];
    n_pairs, i : INTEGER;
BEGIN
    Write("Enter number of pairs: ");
    Read(n_pairs);

    FOR i FROM 1 TO n_pairs DO
        // Read v1 and v2 elements here

        IF (dot_product_func(v1, v2) = 0) THEN
            Write("Vectors are Orthogonal");
        ELSE
            Write("Vectors are NOT Orthogonal");
        END_IF
    END_FOR
END_ALGORITHM
